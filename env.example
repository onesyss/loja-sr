# Copie para .env.local e preencha (não commite .env.local)

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Use uma das duas (painel novo: Publishable / legado: anon public).
# Não deixe ANON_KEY= vazio se PUBLISHABLE_KEY estiver preenchida — string vazia quebra o cliente (Invalid Compact JWS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: se a API de produtos falhar, mostrar dados demo (só para testes locais).
# NEXT_PUBLIC_USE_MOCK_PRODUCTS=true

# URL pública (local: abaixo; produção Vercel deste repo: https://loja-sr.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mercado Pago — Credenciais de produção ou teste
MERCADOPAGO_ACCESS_TOKEN=
